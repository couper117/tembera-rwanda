# Neon Postgres. Take BOTH strings from the Neon dashboard or `neon connection-string`.
#
# DATABASE_URL is the POOLED endpoint (the host contains "-pooler"). The running
# app uses it, so serverless functions share a small pool instead of opening a
# connection each.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
#
# DIRECT_URL is the DIRECT endpoint (no "-pooler"). Only `prisma migrate` uses
# it: Neon's pooler runs PgBouncer in transaction mode, which cannot hold the
# session locks migrations need.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Seeding only. Set to "true" to let the seed wipe and reload the catalog.
# Refused outright when NODE_ENV=production — see prisma/seed.ts.
# SEED_RESET="true"

# Optional: the address shown on the privacy page for data questions. If unset
# the page says so plainly rather than printing a fake-looking address.
PRIVACY_CONTACT_EMAIL=""

# Auth.js session signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Auth.js refuses to trust the Host header in production unless told to, which
# breaks `next start` behind any proxy — including a local one. Vercel is
# detected automatically and needs no value; set this to "true" when running a
# production build anywhere else you control the proxy in front of it.
AUTH_TRUST_HOST="true"

# Optional: where a paid business sign-up sends its mobile money, and the name
# that should appear on the payer's confirmation so they can check it before
# sending. Both or neither — half a set of payment details reads as configured
# while sending money somewhere nobody can confirm, so the sign-up screen says
# "we will email you the number" until both are set.
TEMBERA_MOMO_NUMBER=""
TEMBERA_MOMO_NAME=""

# RwandaPay. The secret key authorises every charge this app can make, so it is
# server-side only — never give it a NEXT_PUBLIC_ prefix, which compiles it
# into the browser bundle. With these unset, paid sign-ups fall back to the
# mobile-money-by-hand route and an admin confirms them on /admin/businesses.
RWANDAPAY_BASE_URL="https://pay.rwandapay.rw/api/v1"
RWANDAPAY_PUBLIC_KEY=""
RWANDAPAY_SECRET_KEY=""
# Shared secret for the HMAC-SHA256 on webhook deliveries. Unset means every
# webhook is treated as unsigned — still safe, because the endpoint asks the
# API rather than trusting the body, but set it in production.
RWANDAPAY_WEBHOOK_SECRET=""

# Absolute origin, for the URLs handed to the payment gateway to redirect and
# call back to. Derived from the request when unset; set it behind a proxy that
# rewrites Host, where the request's own view of itself can be wrong.
PUBLIC_SITE_URL=""

# Travel assistant (/admin/chatbot). Optional: without a key the assistant
# still answers from the catalogue, the calendar and the business pages.
#
# Only read when no configuration has been saved from the dashboard — a saved
# row wins, so removing the key there genuinely removes it.
#
# Model names retire. gemini-1.5-flash went, then gemini-2.0-flash, each time
# turning a working install into a 404 that only shows in the chat. Use the
# "List models" button on /admin/chatbot rather than guessing.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
