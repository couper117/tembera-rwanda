# Postgres connection string used by Prisma.
# Local example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tourism_db?schema=public"

# Secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: enables the live Google Map on /map. Leave blank to disable.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
