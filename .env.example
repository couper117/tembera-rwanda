# Postgres connection string used by Prisma.
# Local example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tourism_db?schema=public"

# Secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: enables the live Google Map on /map. Leave blank to disable.
# This ships to the browser by design — restrict it by HTTP referrer in the
# Google Cloud console. That restriction is its only real protection.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# Seeding only. Both are read by `npm run db:seed`.
#
# SEED_ADMIN_PASSWORD sets the admin password (12+ characters). Leave it unset
# and the seed generates one and prints it once — there is no default password.
# SEED_ADMIN_PASSWORD=""
#
# SEED_DEMO_USER=true also creates demo@tembera.rw / demo12345. That password is
# published in the README, so never set this in production.
# SEED_DEMO_USER="true"
