# Neon Postgres. Take BOTH strings from the Neon dashboard or `neon connection-string`.
#
# DATABASE_URL is the POOLED endpoint (the host contains "-pooler"). The running
# app uses it, so serverless functions share a small pool instead of opening a
# connection each.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
#
# DIRECT_URL is the DIRECT endpoint (no "-pooler"). Only `prisma migrate` uses
# it: Neon's pooler runs PgBouncer in transaction mode, which cannot hold the
# session locks migrations need.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Seeding only. Set to "true" to let the seed wipe and reload the catalog.
# Refused outright when NODE_ENV=production — see prisma/seed.ts.
# SEED_RESET="true"

# Optional: enables the live Google Map on /map. Leave blank to use the static
# fallback. This ships to the browser by design — restrict it by HTTP referrer
# in the Google Cloud console. That restriction is its only real protection.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# Optional: the address shown on the privacy page for data questions. If unset
# the page says so plainly rather than printing a fake-looking address.
PRIVACY_CONTACT_EMAIL=""
