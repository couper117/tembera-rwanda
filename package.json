{
  "name": "nga-tourism-project",
  "version": "1.0.0",
  "private": true,
  "description": "Visit Rwanda / Tembera tourism guide — Next.js + Prisma + Neon Postgres",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:auth": "tsx scripts/e2e-auth.ts",
    "test:writes": "tsx scripts/e2e-writes.ts",
    "test:admin": "tsx scripts/e2e-admin.ts",
    "test:business": "tsx scripts/e2e-business.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "freeze-ids": "tsx scripts/freeze-ids.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "verify-seed": "tsx scripts/verify-seed.ts",
    "set-password": "tsx scripts/set-password.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "next": "15.5.23",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.18.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.23",
    "playwright-core": "^1.62.1",
    "prisma": "^7.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
