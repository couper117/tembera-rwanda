

# Auto-committer ignored files
*.tmp
*.temp
*.log
*.cache
*.dll
*.exe
*.env
.vscode/**
.idea/**
.vs/**
node_modules/**
.git/**
dist/**
build/**
*.swp
*.swo
.DS_Store
Thumbs.db

# Next.js / Node
/.next/
/out/
/node_modules/
next-env.d.ts.timestamp
.env
.env*.local

# Prisma
/prisma/*.db

# Uploaded admin images (served from /public/uploads)
/public/uploads/*
!/public/uploads/.gitkeep

# TypeScript incremental build cache (produced by `tsc --noEmit`)
*.tsbuildinfo

# Production builds from scripts/serve.sh, kept out of the dev server way.
.next-serve/
